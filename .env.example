# ==========================================================
# Cognitive Module: Audio Speech-to-Text Environment Config
# ==========================================================

# Required: Deepgram API Key (Get yours at https://console.deepgram.com/)
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY_HERE

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Default Transcription Settings
# Recommended for English-Hindi code-switching: model="nova-3", language="multi"
DEFAULT_MODEL=nova-3
DEFAULT_LANGUAGE=multi

# Transcription Feature Flags
DEFAULT_DIARIZE=true
DEFAULT_SMART_FORMAT=true
DEFAULT_PUNCTUATE=true
DEFAULT_PARAGRAPHS=true
DEFAULT_UTTERANCES=true
